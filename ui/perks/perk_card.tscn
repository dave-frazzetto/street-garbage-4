[gd_scene format=3]

[ext_resource type="Script" path="res://ui/perks/perk_card.gd" id="1_card"]

[node name="PerkCard" type="PanelContainer"]
custom_minimum_size = Vector2(280, 340)
script = ExtResource("1_card")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Category" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.7, 0.75, 1)
theme_override_font_sizes/font_size = 16
text = "COMBAT"
horizontal_alignment = 1

[node name="Name" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "TRIGGER HAPPY"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Rarity" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "COMMON"
horizontal_alignment = 1

[node name="Sep" type="HSeparator" parent="VBox"]
layout_mode = 2
mouse_filter = 2

[node name="Effects" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 19
text = "Rate of Fire: 0% -> 12.5%"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Flavour" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.65, 0.7, 1)
theme_override_font_sizes/font_size = 14
horizontal_alignment = 1
autowrap_mode = 3
