.godot/
/tools/
/build/
*.tmp
/tests/output/
export_credentials.cfg
*.import

# third-party reference art (copyrighted, not for redistribution)
/art/concept art/

# generated-art working files: Meshy task sidecars hold signed URLs, reference images are the (re-creatable) prompts inputs
/art/models/**/reference/
/art/models/**/*_meta.json
/art/tools/.tasks/

# textures Godot extracts next to a GLB on import; they are regenerated from the GLB, so only the GLB is committed
/art/models/**/*_texture_*.png
/art/models/**/*_normal.png
/art/models/**/*_emissive.png
/art/models/**/*_Image_0.png
